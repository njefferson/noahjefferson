{
  "permissions": {
    "allow": [
      "Artifact",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git ls-remote:*)",
      "Bash(git fetch:*)",
      "Bash(git worktree add:*)",
      "Bash(git merge --ff-only:*)",
      "Bash(git pull --ff-only:*)",
      "Bash(npm --prefix /home/user/Jefferson-Photography-Studio run build:*)",
      "Bash(npm --prefix /tmp/claude-0/*/scratchpad/hubwt ci)",
      "Bash(node /home/user/Jefferson-Photography-Studio/tools/:*)",
      "Bash(node /home/user/noahjefferson/plan-scope-check.mjs:*)",
      "Bash(node /root/.claude/hub/reply-guard.mjs --read:*)",
      "Bash(node /tmp/claude-0/:*)",
      "Bash(node --check:*)",
      "Bash(python3 -m http.server:*)",
      "Bash(python3 -I -m zipfile:*)",
      "Bash(node /home/user/noahjefferson/session-guards.test.mjs:*)",
      "Bash(node /home/user/noahjefferson/docs-check.mjs:*)",
      "Bash(node /home/user/noahjefferson/lessons-check.mjs:*)",
      "Bash(node /home/user/noahjefferson/quote-check.mjs:*)",
      "Bash(node /home/user/noahjefferson/privacy-check.mjs:*)",
      "Bash(node /home/user/noahjefferson/third-person-check.mjs:*)",
      "Bash(node /home/user/noahjefferson/example-check.mjs:*)",
      "Bash(node /home/user/noahjefferson/pin-check.mjs:*)",
      "Bash(git rebase origin/main)",
      "Bash(git rm:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git -C /root/.claude/hub pull /home/user/noahjefferson main)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/stop-guard.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/plan-guard.sh"
          }
        ]
      }
    ]
  }
}
